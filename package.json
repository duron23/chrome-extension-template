{
  "name": "chrome-extension-template",
  "version": "1.1.0",
  "author": "Farooq Hussain M",
  "license": "ISC",
  "description": "",
  "sideEffects": false,
  "scripts": {
    "prebuild:dev": "cross-env NODE_ENV=dev node generate-manifest.js",
    "prebuild:uat": "cross-env NODE_ENV=uat node generate-manifest.js",
    "prebuild:prod": "cross-env NODE_ENV=prod node generate-manifest.js",
    "build:dev": "webpack --config webpack.dev.config.js",
    "build:uat": "webpack --config webpack.uat.config.js",
    "build:prod": "webpack --config webpack.prod.config.js",
    "build:analyze": "cross-env ANALYZE=true npm run build:prod",
    "watch": "webpack --watch --progress --config webpack.watch.config.js",
    "clean": "rimraf dist .tsbuildinfo",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:e2e": "tsx tests/e2e/test.ts",
    "test:e2e:headless": "cross-env HEADLESS=true tsx tests/e2e/test.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint:check && npm run test:unit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.2",
    "@vitest/ui": "^3.2.2",
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.7",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "postcss-loader": "^8.1.1",
    "puppeteer": "^24.10.0",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.8",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.2",
    "webpack": "^5.99.9",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "xml2js": "^0.6.2"
  }
}
