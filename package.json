{
  "name": "chrome-extension-template",
  "version": "1.2.0",
  "author": "Farooq Hussain M",
  "license": "ISC",
  "description": "A modern Chrome extension template with comprehensive tooling",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "ensure-pem": "node scripts/ensure-pem.js",
    "prebuild:dev": "cross-env NODE_ENV=dev npm run ensure-pem && cross-env NODE_ENV=dev node scripts/generate-manifest.js",
    "prebuild:uat": "cross-env NODE_ENV=uat npm run ensure-pem && cross-env NODE_ENV=uat node scripts/generate-manifest.js",
    "prebuild:prod": "cross-env NODE_ENV=prod npm run ensure-pem && cross-env NODE_ENV=prod node scripts/generate-manifest.js",
    "build:dev": "webpack --config webpack/webpack.dev.config.js",
    "build:uat": "webpack --config webpack/webpack.uat.config.js",
    "build:prod": "webpack --config webpack/webpack.prod.config.js",
    "build:analyze": "cross-env ANALYZE=true npm run build:prod",
    "customize": "node scripts/customize-features.js",
    "show:ids": "node scripts/show-extension-ids.js",
    "watch": "webpack --watch --progress --config webpack/webpack.watch.config.js",
    "cleanup": "rimraf dist coverage .tsbuildinfo",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run",
    "test:e2e": "tsx tests/e2e/test.ts",
    "test:e2e:headless": "cross-env HEADLESS=true tsx tests/e2e/test.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint:check && npm run test:unit",
    "archive": "git archive --format=zip --output=chrome-extension-template.zip HEAD"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.332",
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.0.0",
    "postcss-loader": "^6.0.0",
    "proper-lockfile": "^4.1.2",
    "puppeteer": "^24.12.1",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "webpack": "^5.100.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "xml2js": "^0.6.2"
  }
}