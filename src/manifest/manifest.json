{
  "manifest_version": 3,
  "name": "dev : <CHANGE_ME>",
  "version": "0.0.0",
  "description": "dev : <CHANGE_ME>",
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content/content.bundle.js"
      ],
      "matches": [
        "http://localhost/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "host_permissions": [
    "http://localhost/*"
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "offscreen",
    "downloads"
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "options.css",
        "popup.css",
        "sidepanel.css",
        "offscreen.css",
        "content/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}