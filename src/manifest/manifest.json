{
  "manifest_version": 3,
  "name": "UAT : Chrome Extension Template",
  "version": "0.0.0",
  "description": "UAT : A modern Chrome extension template with comprehensive tooling",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "js": [
        "content/content-script.bundle.js",
        "content/example2.content.bundle.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}